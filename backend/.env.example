# Backend Environment Configuration

# Development/Demo Settings
NODE_ENV=development
PORT=5000

# Database (PostgreSQL + PostGIS)
# In production, configure with real database
DATABASE_URL=postgresql://user:password@localhost:5432/canesense
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canesense
DB_USER=postgres
DB_PASSWORD=password

# Google Earth Engine
# Replace with your GEE project ID and credentials
GEE_PROJECT_ID=your-gee-project-id
GEE_CREDENTIALS_PATH=./config/gee-credentials.json

# External APIs
MAPBOX_TOKEN=your-mapbox-token
WEATHER_API_KEY=your-weather-api-key

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mode Flag
IS_DEMO_MODE=true
DEMO_DATA_BADGE=🏷️

# Study Area (Baitul, Madhya Pradesh)
STUDY_AREA_NAME=Baitul
STUDY_AREA_STATE=Madhya Pradesh
STUDY_AREA_COUNTRY=India
STUDY_AREA_CENTER_LAT=21.75
STUDY_AREA_CENTER_LNG=76.2
